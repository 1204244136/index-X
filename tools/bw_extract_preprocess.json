{
  "searches": [
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<ruby>(.*?)([^<]+)<rt>([^<]+)</rt>([^<]+)<rt>([^<]+)</rt>(.*?)</ruby>",
      "mode": "regex",
      "name": "bw提取预处理-ruby修正",
      "iterative": true,
      "replace": "<ruby>\\1\\2\\4<rt>\\3\\5</rt>\\6</ruby>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<p><br/></p>",
      "mode": "regex",
      "name": "<br/>展平",
      "replace": "<br/>"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "\\s*(?:(?:<p><br\\s*/?></p>|<br\\s*/?>)\\s*)+(?=</div>)",
      "mode": "regex",
      "name": "页尾填充br删除",
      "replace": "\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<div class=\"main\">)\\s*(?:<br\\s*/?>[\\r\\n]*)*",
      "mode": "regex",
      "name": "页首填充br删除(main后)",
      "replace": "\\1\n"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"font-1em50\">(.*?)</span>",
      "mode": "regex",
      "name": "标题span解包",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"em-sesame\">(.*?)</span>",
      "mode": "regex",
      "name": "着重号span转b标签",
      "replace": "<b>\\1</b>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"tcy\">(.*?)</span>",
      "mode": "regex",
      "name": "纵中横span解包",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<p class=\"line-break-loose\">(.*?)</p>",
      "mode": "regex",
      "name": "行宽松样式解包",
      "replace": "<p>\\1</p>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"line-break-loose word-break-break-all\">(.*?)</span>",
      "mode": "regex",
      "name": "换行样式span解包",
      "replace": "\\1"
    }
  ],
  "version": 2,
  "_comment": "职责边界调整（v2）：本规则集只清理 BookWalker 排版噪声（ruby 合并、font/span 解包、页首/页尾填充 br）。头部折叠、容器解包（start-3em/start-5em）、p 型标题转 h1、数字小节转 h2 等「套用固定行模板」操作已移除，由 normalize_paired.py / normalize_single.py 共用的规范化核心处理。"
}
