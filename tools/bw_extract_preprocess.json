{
  "searches": [
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<ruby>(.*?)([^<]+)<rt>([^<]+)</rt>([^<]+)<rt>([^<]+)</rt>(.*?)</ruby>",
      "mode": "regex",
      "name": "bw提取预处理-ruby修正",
      "iterative": true,
      "replace": "<ruby>\\1\\2\\4<rt>\\3\\5</rt>\\6</ruby>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<p><br/></p>",
      "mode": "regex",
      "name": "<br/>展平",
      "replace": "<br/>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"tcy\">(.*?)</span>",
      "mode": "regex",
      "name": "纵中横span解包",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<\\?xml[^>]*\\?>)\\s+<!DOCTYPE html>\\s+<html\\b[^>]*\\bclass=\"(?:vrtl|hltr)\"[^>]*>\\s+<head>(?:(?!</head>).)*?<title>(.*?)</title>.*?</head>\\s+<body class=\"p-text\">\\s+<div class=\"main(?:\\s+[^\"]*)?\">\\s*(?:<br/>\\s*)*",
      "mode": "regex",
      "name": "头部整体合并为L3单行+main后两空行占位",
      "replace": "\\1\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\" xml:lang=\"ja\" class=\"vrtl\"><head><meta charset=\"UTF-8\"/><title>\\2</title><link rel=\"stylesheet\" type=\"text/css\" href=\"../style/book-style.css\"/></head><body class=\"p-text\"><div class=\"main\">\n\n\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<div class=\"main(?:\\s+[^\"]*)?\">)\\s*<div class=\"start-3em\">\\s*<p([^>]*)>(.*?)</p>\\s*</div>",
      "mode": "regex",
      "name": "章节容器折叠为h1独占行(L4)",
      "replace": "\\1\n<h1\\2>\\3</h1>\n\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<div class=\"main(?:\\s+[^\"]*)?\">)\\s*<p\\b([^>]*)>\\s*<span class=\"(?:font-130per|font-1em30)\">(.*?)</span>\\s*</p>",
      "mode": "regex",
      "name": "早期格式span大字标题折叠为h1独占行(L4)",
      "replace": "\\1\n<h1\\2>\\3</h1>\n\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<div class=\"main(?:\\s+[^\"]*)?\">)\\s*<p\\b([^>]*class=\"[^\"]*font-1em30[^\"]*\"[^>]*)>(.*?)</p>",
      "mode": "regex",
      "name": "早期格式p大字标题折叠为h1独占行(L4)",
      "replace": "\\1\n<h1\\2>\\3</h1>\n\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<div class=\"main(?:\\s+[^\"]*)?\">)\\s*<p\\b([^>]*\\bid=\"toc-\\d+\"[^>]*)>(?:【)?(序章|終章|プロローグ|エピローグ|あとがき|第[一二三四五六七八九十0-9]+[章話]|目次)(.*?)(?:】)?</p>",
      "mode": "regex",
      "name": "语义段落标题折叠为h1独占行(L4)",
      "replace": "\\1\n<h1\\2>\\3\\4</h1>\n\n"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "(<h1\\b[^>]*>)[ \\t\\r\\n]+(?=.)",
      "mode": "regex",
      "name": "跨行h1折叠为单行",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<h1[^>]*>.*?</h1>)\\s*(?:<br/>\\s*)*<div class=\"start-3em\">\\s*<p([^>]*)>([0-9０-９]+)</p>\\s*</div>\\s*(?:<br/>\\s*)*",
      "mode": "regex",
      "name": "首小节容器折叠为h2独占行(L5,h1后,start-3em数字)",
      "replace": "\\1\n<h2\\2>\\3</h2>\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<h1[^>]*>.*?</h1>)\\s*(?:<br/>\\s*)*<div class=\"start-5em\">\\s*<p([^>]*)>(.*?)</p>\\s*</div>\\s*(?:<br/>\\s*)*",
      "mode": "regex",
      "name": "首小节容器折叠为h2独占行(L5,h1后)",
      "replace": "\\1\n<h2\\2>\\3</h2>\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<h1[^>]*>.*?</h1>)\\s*(?:<br\\s*/?>\\s*)*<p\\b[^>]*>[ 　]*([0-9０-９]+(?:（[^）]*）)?|◇)[ 　]*</p>\\s*(?:<br\\s*/?>\\s*)*",
      "mode": "regex",
      "name": "首小节裸段落折叠为h2独占行(L5,h1后)",
      "replace": "\\1\n<h2>\\2</h2>\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<div class=\"main\">)\\s*(?:<br/>\\s*)*<div class=\"start-5em\">\\s*<p([^>]*)>(.*?)</p>\\s*</div>\\s*(?:<br/>\\s*)*",
      "mode": "regex",
      "name": "首小节容器折叠为h2独占行(L5,无h1)",
      "replace": "\\1\\n\\n<h2\\2>\\3</h2>\\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<div class=\"main\">)\\s*(?:<p>\\s*<br\\s*/?\\s*>\\s*</p>\\s*)*<p\\b[^>]*>[ 　]*([0-9０-９]+(?:（[^）]*）)?|◇)[ 　]*</p>\\s*(?:<p>\\s*<br\\s*/?\\s*>\\s*</p>\\s*)*",
      "mode": "regex",
      "name": "首小节裸段落折叠为h2独占行(L5,无h1无容器)",
      "replace": "\\1\\n\\n<h2>\\2</h2>\\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "<div class=\"start-3em\">\\s*<p([^>]*)>([0-9０-９]+)</p>\\s*</div>",
      "mode": "regex",
      "name": "正文中部小节容器折叠为h2行(start-3em数字)",
      "replace": "<h2\\1>\\2</h2>"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "<div class=\"start-5em\">\\s*<p([^>]*)>(.*?)</p>\\s*</div>",
      "mode": "regex",
      "name": "正文中部小节容器折叠为h2行",
      "replace": "<h2\\1>\\2</h2>"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<h1[^>]*>.*?</h1>)\\s*(?:<br/>\\s*)*(<p\\b)",
      "mode": "regex",
      "name": "h1后填充br清理+空行占位",
      "replace": "\\1\n\n\\2"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "^<p\\b[^>]*>[ 　]*([0-9０-９]+(?:（[^）]*）)?|◇)[ 　]*</p>\\r?$",
      "mode": "regex",
      "name": "裸数字小节转为h2",
      "replace": "<h2>\\1</h2>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "\\n(?:\\s*<br\\s*/?>\\s*)+(?=<h2\\b)",
      "mode": "regex",
      "name": "h2前填充br清理",
      "replace": "\n"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "(<h2\\b[^>]*>.*?</h2>)(?:\\s*<br\\s*/?>\\s*)+",
      "mode": "regex",
      "name": "h2后填充br清理",
      "replace": "\\1\n"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "\\s*(?:(?:<p><br\\s*/?></p>|<br\\s*/?>)\\s*)+(?=</div>)",
      "mode": "regex",
      "name": "页尾填充br删除",
      "replace": "\n"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "^[ \\t]*<div class=\"(align-end|align-center|align-right|gfont|font-1em30 start-2em|start-4em|h-indent-1em|h-indent-5em)\">[ \\t]*\\r?\\n[ \\t]*<p>([^\\n]*)</p>[ \\t]*\\r?\\n[ \\t]*</div>[ \\t]*$",
      "mode": "regex",
      "name": "单段排版容器折叠为带类名的p",
      "replace": "<p class=\"\\1\">\\2</p>"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(?:<br\\s*/?>\\s*)+(<p\\b[^>]*>\\s*<(?:img|image)\\b[^>]*/>\\s*</p>|<svg\\b)",
      "mode": "regex",
      "name": "图片前填充br清理",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "(<p\\b[^>]*>\\s*<(?:img|image)\\b[^>]*/>\\s*</p>|</svg>)\\s*(?:<br\\s*/?>\\s*)+(?=<)",
      "mode": "regex",
      "name": "图片后填充br清理",
      "replace": "\\1\n"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"font-1em50\">(.*?)</span>",
      "mode": "regex",
      "name": "标题span解包",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"em-sesame\">(.*?)</span>",
      "mode": "regex",
      "name": "着重号span转b标签",
      "replace": "<b>\\1</b>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<p class=\"line-break-loose\">(.*?)</p>",
      "mode": "regex",
      "name": "行宽松样式解包",
      "replace": "<p>\\1</p>"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "<span class=\"line-break-loose word-break-break-all\">(.*?)</span>",
      "mode": "regex",
      "name": "换行样式span解包",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": true,
      "find": "<div class=\"font-080per\">\\s*(<p>.*?</p>)\\s*</div>",
      "mode": "regex",
      "name": "说明div解包",
      "replace": "\\1"
    },
    {
      "case_sensitive": false,
      "dot_all": false,
      "find": "(<(?:p|h1|h2)\\b[^>]*>)[　 ]+",
      "mode": "regex",
      "name": "段首排版空格清理",
      "replace": "\\1"
    }
  ],
  "version": 6,
  "_comment": "恢复分页合并所需的固定行模板契约：正文页折叠 L1-L3，章节标题转 h1（含跨行 h1 折叠为单行），数字小节转 h2，无标题页保留 L4/L5 空槽；同时清理 BookWalker 排版噪声（含 h2 前后填充 br 清理）。v6：单段排版 div 容器折叠从 align-end 推广到 align-center/align-right/gfont/h-indent-*/start-*/font-1em30 start-2em 白名单，并改为行锚定匹配，杜绝把多段容器吞成一行。"
}
